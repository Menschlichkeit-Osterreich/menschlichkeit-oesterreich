{
  "name": "Menschlichkeit Österreich Development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/php:1": {
      "version": "8.2"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/node:1",
    "ghcr.io/devcontainers/features/python:1",
    "ghcr.io/devcontainers/features/php:1",
    "ghcr.io/devcontainers/features/github-cli:1",
    "ghcr.io/devcontainers/features/powershell:1",
    "ghcr.io/devcontainers/features/git:1",
    "ghcr.io/devcontainers/features/docker-in-docker:2"
  ],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "64gb"
  },
  "onCreateCommand": "bash .devcontainer/onCreate-setup.sh",
  "postCreateCommand": "bash .devcontainer/setup.sh && if [ -f scripts/dev/codespace-ssh-setup.sh ]; then bash scripts/dev/codespace-ssh-setup.sh; fi && if ! command -v uv >/dev/null 2>&1; then curl -LsSf https://astral.sh/uv/install.sh | sh; fi",
  "postStartCommand": "pwsh .devcontainer/setup-powershell.ps1 || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bmewburn.vscode-intelephense-client",
        "ms-playwright.playwright",
        "bradlc.vscode-tailwindcss",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "ms-vscode.powershell",
        "prisma.prisma",
        "redhat.vscode-yaml",
        "codacy-app.codacy"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash"
          },
          "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
          }
        },
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "php.validate.executablePath": "/usr/local/php/current/bin/php",
        "github.copilot.enable": {
          "*": true,
          "markdown": false,
          "yaml": false,
          "json": false,
          "scminput": false,
          "dotenv": false
        },
        "github.copilot.nextEditSuggestions.enabled": true,
        "editor.inlineSuggest.edits.allowCodeShifting": "never",
        "files.watcherExclude": {
          "**/.cache/**": true,
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/.mypy_cache/**": true,
          "**/.next/**": true,
          "**/.pnpm-store/**": true,
          "**/.pytest_cache/**": true,
          "**/.ruff_cache/**": true,
          "**/.venv/**": true,
          "**/__pycache__/**": true,
          "**/build/**": true,
          "**/coverage/**": true,
          "**/dist/**": true,
          "**/node_modules/**": true,
          "**/vendor/**": true
        }
      }
    }
  },
  "containerEnv": {
    "AGENT_INSTALL_PLAYWRIGHT": "1",
    "BWS_SERVER_URL": "https://vault.bitwarden.eu",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "COMPOSER_PROCESS_TIMEOUT": "1200"
  },
  "forwardPorts": [3001, 5173, 8000, 8001, 8002],
  "portsAttributes": {
    "3001": {
      "label": "Games Server",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend (Vite)",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "CRM Server",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "API Server",
      "onAutoForward": "notify"
    },
    "8002": {
      "label": "Forum Server",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "codespace"
}
